# Vercel AI Gateway key: https://vercel.com/dashboard → AI Gateway → API Keys
AI_GATEWAY_API_KEY=

# Any model id from https://vercel.com/ai-gateway/models
AI_MODEL=google/gemini-2.5-flash-lite

# Vision model that transcribes uploaded screenshots to text
AI_OCR_MODEL=google/gemini-2.5-flash

POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Where the database is reachable from your machine (Prisma CLI on the host): localhost and a free port.
# docker compose publishes the db on this port and points the backend container to db:5432 instead.
POSTGRES_HOST=
POSTGRES_PORT=
