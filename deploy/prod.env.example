# Production variables. On the server: cp deploy/prod.env.example .env, then fill in.
# Generate each secret with: openssl rand -base64 48 | tr -d '/+='

# Public hostnames. Before the real domain, use sslip.io names that resolve to the server's IP
# (terraform output prints them), e.g. mood.3-121-50-7.sslip.io and auth.3-121-50-7.sslip.io.
APP_DOMAIN=
AUTH_DOMAIN=

AI_GATEWAY_API_KEY=
AI_MODEL=google/gemini-2.5-flash-lite
AI_OCR_MODEL=google/gemini-2.5-flash

POSTGRES_USER=aimood
POSTGRES_PASSWORD=
POSTGRES_DB=aimood
# Leave empty for the db container. For RDS: its endpoint and port.
POSTGRES_HOST=
POSTGRES_PORT=

# Keycloak's own database user (created on the first start of the db container).
KEYCLOAK_DB_PASSWORD=
# Temporary admin of Keycloak's admin console (user "admin").
KEYCLOAK_ADMIN_PASSWORD=
# Shared by Keycloak's "bff" client and the BFF. Read by Keycloak only when the realm is imported.
KEYCLOAK_CLIENT_SECRET=

# Signs the BFF session cookie, at least 32 characters.
SESSION_SECRET=
