generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "esm"
}

// The connection URL is set in prisma.config.ts.
datasource db {
  provider = "postgresql"
}

enum AnalysisSource {
  text
  screenshots
}

enum MoodKind {
  conversation
  message
}

// History of all mood analyses. Will get a user relation once authentication exists.
model MoodAnalysis {
  id           String         @id @default(uuid()) @db.Uuid
  createdAt    DateTime       @default(now()) @map("created_at") @db.Timestamptz
  source       AnalysisSource
  // Analyzed text: the user's input, or the transcript of the screenshots.
  inputText    String         @map("input_text")
  model        String
  language     String
  kind         MoodKind
  inputQuality Float          @map("input_quality") @db.Real
  tone         Int            @db.SmallInt
  dynamics     Int?           @db.SmallInt
  summaryEn    String         @map("summary_en")
  summary      String
  active       Boolean        @default(true)

  @@index([createdAt(sort: Desc)])
  @@map("mood_analyses")
}
