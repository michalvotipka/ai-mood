# Production image: no file watching, no source volume. Runs the TypeScript with tsx like in dev, so
# the dev dependencies (tsx, prisma CLI) stay in the image.
FROM node:24-alpine
WORKDIR /app
ENV NODE_ENV=production
# The Prisma schema and config (with the database URL it imports) are needed by `prisma generate`
# in postinstall.
COPY package*.json prisma.config.ts ./
COPY prisma ./prisma
COPY src/config/database.ts ./src/config/
RUN npm ci --include=dev
COPY . .
EXPOSE 43100
# `prestart` applies pending migrations first.
CMD ["npm", "start"]
