# Builds the static app and serves it with Caddy, which is also the HTTPS entry point of the whole
# stack (its Caddyfile comes from deploy/ in docker-compose.prod.yml).
FROM node:24-alpine AS build
WORKDIR /app
COPY package*.json ./
RUN npm ci
COPY . .
RUN npm run build

FROM caddy:2-alpine
COPY --from=build /app/dist /srv
